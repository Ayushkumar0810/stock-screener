{
  "name": "stock-screener-pro",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev": "node ./node_modules/next/dist/bin/next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "node ./node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "ws": "tsx server/ws-server.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run ws\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "clsx": "^2.1.1",
    "idb": "^8.0.1",
    "lightweight-charts": "^5.0.8",
    "lucide-react": "^0.542.0",
    "next": "14.2.33",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "^8.18.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.2.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.33",
    "concurrently": "^9.2.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
